# Copy to .env and adjust. Nothing here is required to start: the defaults run
# the free OpenDota tier and track premium + professional tournaments.

# Public address used for metadata and links.
SITE_URL=http://localhost
PORT=80

# --- OpenDota ---------------------------------------------------------------
# The free tier needs no key (about 2000 calls/day, heavily rate limited).
# A key removes the throttling and lets the backfill finish in hours, not days:
# https://www.opendota.com/api-keys
OPENDOTA_API_KEY=
# Leave empty to use the built-in default (1900 free / 200000 keyed).
OPENDOTA_DAILY_LIMIT=
# Minimum gap between calls. The free tier gets throttled below ~1400ms.
OPENDOTA_REQUEST_GAP_MS=

# --- Which tournaments get a page -------------------------------------------
# Comma separated OpenDota tiers. Empty means every tier, including junk leagues.
TOURNAMENT_TIERS=premium,professional
# A tournament counts as running while maps keep arriving inside this window.
TOURNAMENT_LIVE_WINDOW_HOURS=24
TOURNAMENT_ACTIVE_WINDOW_DAYS=7

# --- Background jobs --------------------------------------------------------
SCHEDULER_ENABLED=true
JOB_DISCOVER_MINUTES=60
JOB_SYNC_ACTIVE_MINUTES=15
JOB_FORECAST_MINUTES=20
JOB_STRUCTURE_MINUTES=15
STRUCTURE_TTL_MINUTES=15
JOB_COLLECT_HOURS=3
JOB_BACKFILL_MINUTES=30
JOB_DRAFT_DETAIL_MINUTES=30
JOB_RETRAIN_HOURS=24
# Leagues re-pulled in full on each sync pass.
JOB_SYNC_MAX_LEAGUES=12

# --- Live polling -----------------------------------------------------------
# The draft is the moment that matters, so the poll tightens while one is open
# and relaxes once heroes are locked or nothing is running.
LIVE_DRAFT_INTERVAL_SECONDS=20
# Draft predictions first observed after this game time remain visible live but
# are not frozen/scored as pre-game-quality calls.
DRAFT_FREEZE_MAX_SECONDS=180
LIVE_GAME_INTERVAL_SECONDS=90
LIVE_IDLE_INTERVAL_SECONDS=300

# --- Data windows and training ----------------------------------------------
HISTORY_DAYS=540
RATINGS_WINDOW_DAYS=540
RATINGS_HOLDOUT_DAYS=45
DRAFT_WINDOW_DAYS=800
DRAFT_MIN_MAPS=1500
DRAFT_STRENGTH_FOLDS=8
# Require this much rolling-origin log-loss improvement before replacing the
# active ratings model. Zero still rejects any regression.
RATINGS_MIN_LOGLOSS_IMPROVEMENT=0
FORECAST_ITERATIONS=20000

# --- Model artifact locations ----------------------------------------------
# Ratings and the draft model are trained by this server on the matches it
# collected; nothing is shipped or inherited. Defaults write to ./models,
# which is untracked. In Docker they point at the data volume so a container
# rebuild keeps them.
# TEAM_RATINGS_MODEL=models/team-ratings.json
# DRAFT_TEMPORAL_MODEL=models/draft-temporal-model.json
# The mid-game gold-lead layer has no retrainer yet and is read-only. Point it
# at a path that does not exist to switch that layer off entirely.
# LIVE_MAP_MODEL=public/live-map-model.json
# DATA_DIR=data

# --- Archive import ---------------------------------------------------------
# Drop a .sqlite archive of past matches into this directory and the server
# imports it by itself within 10 minutes, then retrains. Each file is imported
# once; replacing it triggers a new import. Default: <DATA_DIR>/import
# IMPORT_DIR=data/import
# Extra paths also checked. Empty means look only at IMPORT_DIR.
# IMPORT_EXTRA_PATHS=work/draft-training.sqlite
JOB_IMPORT_MINUTES=10

# --- Access -----------------------------------------------------------------
# The site is private: the whole thing sits behind one password, including the
# API. Required — compose refuses to start without it.
#
# Over plain HTTP the password travels in every request and can be read on a
# hostile network. Put HTTPS in front of it, or reach the server over a VPN,
# if that matters to you.
SITE_USER=admin
SITE_PASSWORD=

# --- Admin ------------------------------------------------------------------
# A bearer token for POST /api/admin/jobs/<name> and /api/admin/forecast/<slug>.
# Leave empty and the admin endpoints reject everything.
ADMIN_TOKEN=
